# Local control-plane placeholders. Keep real values only in an ignored .env file.
HF_TOKEN=<local-hf-token>
GH_TOKEN=<local-github-token>

# Public application defaults. These names are registered as Space Variables.
PORT=8000
TEMP_DIR=/app/temp
MAX_FILE_SIZE_MB=120
REQUEST_TIMEOUT_SECONDS=1200
MAX_CONCURRENT_TASKS=2
WORKERS=1
PROCESS_LOCK_FILE=/app/temp/docxaio-hfs/process.lock
